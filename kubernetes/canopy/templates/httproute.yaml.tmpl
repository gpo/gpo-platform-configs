kind: HTTPRoute
apiVersion: gateway.networking.k8s.io/v1
metadata:
  name: canopy
  namespace: canopy
  labels:
    gateway: canopy
spec:
  parentRefs:
  - kind: Gateway
    name: canopy
    namespace: canopy
    sectionName: tls
  hostnames:
  - "${hostname}"
  rules:
  - backendRefs:
    - name: canopy
      port: 80
