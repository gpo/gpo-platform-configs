apiVersion: apps/v1
kind: Deployment
metadata:
  name: canopy
  labels:
    app: canopy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: canopy
  template:
    metadata:
      labels:
        app: canopy
    spec:
      volumes:
      - name: canopy-nginx-config
        configMap:
          name: canopy-nginx
      - name: static-assets
        emptyDir: {}
      initContainers:
      - name: copy-static-assets
        imagePullPolicy: IfNotPresent
        image: northamerica-northeast2-docker.pkg.dev/gpo-eng-stage/gpo/canopy:latest
        command:
        - sh
        - -c
        - cp -R /app/web/. /tmp/static
        volumeMounts:
        - name: static-assets
          mountPath: /tmp/static
      containers:
      - name: app
        imagePullPolicy: Always
        image: ${image_repository_uri}/canopy:latest
        envFrom:
        - configMapRef:
            name: canopy
        - secretRef:
            name: canopy-db
      # sidecar until the image runs its own web server - see resources/configmap-nginx.yaml
      - name: nginx
        image: nginx:1.27-alpine
        volumeMounts:
        - name: canopy-nginx-config
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf
        - name: static-assets
          mountPath: /app/web
        ports:
        - containerPort: 8080
          name: http
        readinessProbe:
          httpGet:
            path: /healthz
            port: http
        livenessProbe:
          httpGet:
            path: /healthz
            port: http
